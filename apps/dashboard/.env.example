# Canonical template — copy to apps/dashboard/.env.local (never commit .env.local).
#   cp apps/dashboard/.env.example apps/dashboard/.env.local
#
# Dev tiers:
# • Dashboard analyze — NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY are required so users can sign in; POST /api/analyze rejects unauthenticated callers.
# • Dev persistence — without SUPABASE_SERVICE_ROLE_KEY, NODE_ENV=development keeps results in server memory only (see lib/supabase/server.ts).
# • Coach — add OPENAI_API_KEY for /api/chat, /api/coach-says, /api/tab-insight.
# • Production storage — add SUPABASE_SERVICE_ROLE_KEY + GITHUB_OAUTH_ENCRYPTION_KEY (see VERCEL_DEPLOY.md).

# --- Optional: durable storage & GitHub sign-in (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Encrypt GitHub OAuth PATs at rest (required together with Supabase flows that store tokens)
GITHUB_OAUTH_ENCRYPTION_KEY=<long-random-secret>

# --- Optional: OpenAI-powered coach & doc review ---
# OPENAI_API_KEY=
# DOC_REVIEW_ENABLED=false

# --- Optional: higher GitHub throughput for guests (zipball/metadata) ---
# GITHUB_TOKEN=

# Public URL of this app (no trailing slash); helps OAuth redirects behind proxies (Railway/Docker).
# APP_ORIGIN=https://your-host.example

# Optional mirrors for Docker/Railway where NEXT_PUBLIC_* was empty at image build time:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-public-key>

# --- CSE 115A course app: who can sign in (server-side, read at request time) ---
# Comma-separated email domains whose verified Google accounts may sign in. Exact match; subdomains do not count. Default: ucsc.edu
# CSE115A_ALLOWED_EMAIL_DOMAINS=ucsc.edu
# Comma-separated emails that may sign in from any domain and are instructors on every course.
# CSE115A_ADMIN_EMAILS=
# Same domain list for the older /course/[courseId]/analyze page, which checks in the browser (admins are not exposed there).
# NEXT_PUBLIC_CSE115A_ALLOWED_EMAIL_DOMAINS=ucsc.edu

# --- CSE 115A course app: names shown to users (optional; defaults are the Job191 course) ---
# NEXT_PUBLIC_COURSE_NAME=Job191 - Dream Data Labs AI Augmented Software Engineering
# NEXT_PUBLIC_COURSE_SHORT_NAME=Job191
# NEXT_PUBLIC_COURSE_UNIVERSITY=Istinye University
# NEXT_PUBLIC_COURSE_INSTRUCTIONS_URL=https://github.com/Yeterly/ts-repo-metrics/blob/feat/cse115a-g05fb9/docs/job191-sprint-task-specifications.md
