# Example local overrides — placeholders only (no production secrets committed).
# Copy and edit:
#   cp apps/dashboard/.env.local.sample apps/dashboard/.env.local
# Prefer aligning with `.env.example` comments for descriptions.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<replace-with-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<replace-with-service-role-key>

GITHUB_OAUTH_ENCRYPTION_KEY=<replace-with-random-secret-min-32-chars>

# Optional
# OPENAI_API_KEY=<sk-proj-...>
# Course grading through Azure AI Foundry instead of OpenAI (CSE115A_GRADER_MODEL is the deployment name):
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<foundry-key>
# CSE115A_GRADER_MODEL=grader
# GITHUB_TOKEN=
